# CMake build output (both the CPU-only and CUDA rwkv.cpp builds, and the wrapper/app build dirs)
build/
build-cpu/
build-cuda/
build-cpu-app/
build-cuda-app/

# Large model files -- not intended to be committed to git. See inference-engine/README.md for
# how to (re)download and (re)quantize models/ from scratch.
models/*.pth
models/*.bin

# Python
__pycache__/
*.pyc

# Phase 2 voice pipeline: venv and downloaded model files (piper voice .onnx, faster-whisper's
# own HuggingFace-cached Whisper weights under the venv/user cache) -- not intended to be
# committed, same rationale as models/*.bin above. See voice-pipeline/README.md to (re)provision.
voice-pipeline/.venv/
voice-pipeline/models/*.onnx
voice-pipeline/models/*.onnx.json
